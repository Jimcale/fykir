rules_version = '2';

// TEMPORARY — only for running scripts/seed.mjs against a fresh project.
// Deploy firestore.rules (the real, locked-down rules) immediately after
// seeding. Do not leave this deployed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
